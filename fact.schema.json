{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact.schema.json",
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_routed",
            "queued",
            "veto_window",
            "auto_approved",
            "approved",
            "rejected",
            "vetoed",
            "expired"
          ],
          "type": "string"
        },
        "valid_from_t": {
          "type": "number"
        },
        "decided_by": {
          "enum": [
            "auto",
            "producer",
            "autopilot"
          ],
          "type": "string"
        },
        "ttl_s": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "state"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Audit": {
      "additionalProperties": false,
      "description": "Who drafted and checked this fact, in order (SPEC section 19).",
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/AuditStep"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "Audit",
      "type": "object"
    },
    "AuditStep": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "enum": [
            "Scout",
            "Drafter",
            "Verifier"
          ],
          "type": "string"
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "outcome": {
          "type": "string"
        },
        "path": {
          "enum": [
            "foundry_agent",
            "foundry_responses",
            "rules"
          ],
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "attempt",
        "outcome"
      ],
      "title": "AuditStep",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "recompute",
            "evidence_exists",
            "entities",
            "numbers_match",
            "intent_stripped",
            "sample_size"
          ],
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "Check",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": true,
      "properties": {
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "metric": {
          "enum": [
            "goals",
            "shots",
            "xg_sum",
            "attack_share_left",
            "attack_share_centre",
            "attack_share_right",
            "pass_accuracy",
            "turnovers_own_third",
            "duels_lost",
            "win_prob",
            "top_shot_speed",
            "xt_added",
            "substitutions",
            "cards"
          ],
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "comparator": {
          "enum": [
            "eq",
            "gt",
            "lt",
            "share_gt"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "baseline": {
          "type": "number"
        },
        "observed": {
          "$ref": "#/$defs/Observed"
        }
      },
      "required": [
        "subject",
        "metric",
        "window",
        "comparator",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "from",
        "to",
        "reason"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "event_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "players": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/Window"
        }
      },
      "required": [
        "event_ids"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FactText": {
      "additionalProperties": false,
      "properties": {
        "draft_en": {
          "description": "Original drafter wording, kept for the log.",
          "type": "string"
        },
        "canonical_en": {
          "maxLength": 280,
          "type": "string"
        },
        "numbers": {
          "items": {
            "$ref": "#/$defs/TextNumber"
          },
          "type": "array"
        }
      },
      "required": [
        "canonical_en",
        "numbers"
      ],
      "title": "FactText",
      "type": "object"
    },
    "Impact": {
      "additionalProperties": false,
      "properties": {
        "subject_team": {
          "type": "string"
        },
        "win_prob_before": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "win_prob_after": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "delta": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        "method": {
          "const": "poisson_v1",
          "type": "string"
        }
      },
      "required": [
        "delta",
        "method"
      ],
      "title": "Impact",
      "type": "object"
    },
    "Observed": {
      "additionalProperties": true,
      "properties": {
        "value": {
          "type": "number"
        },
        "n": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "Observed",
      "type": "object"
    },
    "Rendition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "cue",
            "caption",
            "audio_script"
          ],
          "type": "string"
        },
        "lang": {
          "enum": [
            "en",
            "es"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "lower_third",
            "score_bug",
            "ticker"
          ],
          "type": "string"
        },
        "duration_s": {
          "type": "number"
        },
        "start_t": {
          "type": "number"
        },
        "numbers_preserved": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "lang",
        "text",
        "numbers_preserved"
      ],
      "title": "Rendition",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2"
          ],
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "tier"
      ],
      "title": "Risk",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "team",
            "player",
            "match"
          ],
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Subject",
      "type": "object"
    },
    "TextNumber": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "TextNumber",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "For a share: the Beta posterior's 95% interval and P(share > league share), which set the\nhedge, and the Wilson interval on the raw counts for comparison (docs/methods/hedging.md).",
      "properties": {
        "n": {
          "minimum": 0,
          "type": "integer"
        },
        "ci_method": {
          "enum": [
            "beta",
            "wilson",
            "none"
          ],
          "type": "string"
        },
        "ci_low": {
          "type": "number"
        },
        "ci_high": {
          "type": "number"
        },
        "hedge": {
          "enum": [
            "none",
            "early",
            "suggests",
            "clear"
          ],
          "type": "string"
        },
        "baseline": {
          "type": "number"
        },
        "p_above": {
          "type": "number"
        },
        "wilson_low": {
          "type": "number"
        },
        "wilson_high": {
          "type": "number"
        }
      },
      "required": [
        "n",
        "ci_method",
        "hedge"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "corrected",
            "rejected",
            "unverifiable"
          ],
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "corrections": {
          "items": {
            "$ref": "#/$defs/Correction"
          },
          "type": "array"
        },
        "reject_reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "title": "Verification",
      "type": "object"
    },
    "Window": {
      "additionalProperties": true,
      "properties": {
        "start_t": {
          "type": "number"
        },
        "end_t": {
          "type": "number"
        }
      },
      "required": [
        "start_t",
        "end_t"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One claim about the match, with its evidence, checks, routing and renditions.",
  "properties": {
    "fact_id": {
      "pattern": "^f_[0-9]{6}$",
      "type": "string"
    },
    "match_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "score_event",
        "stat",
        "moment",
        "milestone",
        "tactical",
        "recap"
      ],
      "type": "string"
    },
    "created_t": {
      "description": "Match clock seconds when proposed.",
      "type": "number"
    },
    "injected": {
      "default": false,
      "description": "True if the drafter deliberately injected an error, for eval only.",
      "type": "boolean"
    },
    "claim": {
      "$ref": "#/$defs/Claim"
    },
    "text": {
      "$ref": "#/$defs/FactText"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "impact": {
      "$ref": "#/$defs/Impact"
    },
    "uncertainty": {
      "$ref": "#/$defs/Uncertainty"
    },
    "audit": {
      "$ref": "#/$defs/Audit"
    },
    "risk": {
      "$ref": "#/$defs/Risk"
    },
    "renditions": {
      "items": {
        "$ref": "#/$defs/Rendition"
      },
      "type": "array"
    }
  },
  "required": [
    "fact_id",
    "match_id",
    "kind",
    "created_t",
    "claim",
    "text",
    "evidence",
    "verification",
    "approval"
  ],
  "title": "Fact",
  "type": "object"
}
